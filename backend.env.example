# Prod env-file, consumed by `docker-compose.prod.yml` via `env_file: ./backend.env`
# on the VPS (path: /opt/winbd/backend.env). Copy this file there as `backend.env`,
# fill in real secrets, and never commit the filled-in version.

PORT=5000
MONGO_URI=mongodb://mongo:27017/newsdb
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_value
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=https://winbd.vindover.ru
